RABBITMQ_URL=amqps://USER:PASSWORD@host.rmq.cloudamqp.com/USER
# same Neon database as the authentication service
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/audioapp?sslmode=require
# free key from console.groq.com: Whisper transcription + answers
GROQ_API_KEY=
# free key from fish.audio: voice cloning on the s2.1-pro-free model
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
# same Cloudinary account as the converter (stores generated voice clips)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# MongoDB with the original uploads (GridFS), read when dubbing a video
MONGODB_CONNECTION_STRING=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
# docker-compose overrides this with http://auth:8001
AUTH_SERVICE_URL=http://localhost:8001
# optional caps that keep usage inside the free tiers
TRANSCRIBE_PER_DAY=10
ASK_PER_DAY=30
VOICE_PER_DAY=5
DUB_PER_DAY=2
DUB_MAX_SECONDS=180
TRANSCRIBE_MAX_SECONDS=600
# account whose processed files are shown publicly on /demo
DEMO_USERMAIL=
